{
  "name": "@thinkcocoa/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./constants": "./src/constants/index.ts",
    "./validators": "./src/validators/index.ts",
    "./kobo-client": "./src/openApi/kobo-client/index.ts",
    "./think-cocoa-client": "./src/openApi/think-cocoa-client/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "kobo-client:snapshot": "curl -sSfL https://kf.kobotoolbox.org/api/v2/schema/ -o src/openApi/kobo-client/schema.yaml && echo 'kobo-client schema saved (YAML) to src/openApi/kobo-client/schema.yaml'",
    "kobo-client:generate": "openapi-ts --file openapi-ts.kobo-client.config.ts",
    "kobo-client:refresh": "bun run kobo-client:snapshot && bun run kobo-client:generate",
    "think-cocoa-client:snapshot": "curl -sSf http://localhost:8000/doc -o src/openApi/think-cocoa-client/schema.json && bun run scripts/format-json.ts src/openApi/think-cocoa-client/schema.json",
    "think-cocoa-client:generate": "openapi-ts --file openapi-ts.think-cocoa-client.config.ts",
    "think-cocoa-client:refresh": "bun run think-cocoa-client:snapshot && bun run think-cocoa-client:generate"
  },
  "dependencies": {
    "@hey-api/client-fetch": "0.13.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.95.0",
    "typescript": "^5.9.3"
  }
}
