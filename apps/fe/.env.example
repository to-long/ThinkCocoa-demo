# FE dev server port (rsbuild). Only used when running `bun run dev`.
PORT=3130

# PUBLIC_API_URL — base URL the FE will hit for every /api/* call,
# baked into the build at compile time (Rsbuild inlines
# `import.meta.env.PUBLIC_API_URL`).
#
#  - Dev (`bun run dev`): leave empty OR set to the FE origin. The
#    rsbuild dev server proxies /api/* to the BE so same-origin
#    requests work without CORS.
#  - Prod build: REQUIRED. Set to the public BE URL.
#      e.g. `https://impact-cocoa.brian-to.dev`
#    No code-level fallback — a missing var aborts the build.
PUBLIC_API_URL=http://localhost:8100

# ── Error tracking ───────────────────────────────────────────────────
# Sentry FE project DSN. Bakes into the FE bundle at build time.
# Leave blank in dev / local builds (auto-disables). For prod, set via
# GitHub Environment variable so it inlines into the deployed bundle.
# Format: https://<key>@o<orgid>.ingest.sentry.io/<projectid>
PUBLIC_SENTRY_DSN=
# Release tag — git SHA, set by deploy.yml at build time.
PUBLIC_SENTRY_RELEASE=
# Environment label for Sentry filtering. Both staging + production
# builds run with MODE=production, so this var separates them in the
# Sentry UI. Set by deploy.yml from the resolved `inputs.env`.
PUBLIC_SENTRY_ENVIRONMENT=
