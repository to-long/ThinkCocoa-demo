{
  "name": "be",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "start:prod": "bun dist/main.js",
    "build": "bun build src/main.ts --target=bun --outdir=dist --minify --sourcemap=linked",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun db/seed/index.ts",
    "db:seed:test-users": "bun db/seed/test-users.ts",
    "db:reset": "docker compose -f ../../docker-compose.yml down -v && docker compose -f ../../docker-compose.yml up -d && sleep 3 && bun db/migrate.ts",
    "db:dump": "bash scripts/dump-demo-db.sh",
    "db:restore": "bash scripts/restore-demo-db.sh",
    "db:test-migrations": "bash scripts/test-migrations.sh",
    "sync:permissions": "bun scripts/sync-permissions.ts",
    "test": "bash scripts/run-tests.sh",
    "test:dev-db": "bun test src/__tests__"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@cocoaimpact/shared": "workspace:*",
    "@hono/node-server": "^1.19.12",
    "@hono/zod-openapi": "1.2.4",
    "@scalar/hono-api-reference": "0.10.6",
    "@sentry/bun": "^10.53.1",
    "better-auth": "^1.5.6",
    "csv-stringify": "^6.8.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.12.9",
    "lru-cache": "^11.3.5",
    "node-cron": "^4.2.1",
    "papaparse": "^5.5.4",
    "pg": "^8.20.0",
    "resend": "^6.17.1",
    "tar": "^7.5.15"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/node-cron": "^3.0.11",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/tar": "^7.0.87",
    "bun-types": "^1.3.13",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
