# ── Server ────────────────────────────────────────────────────────────
# NODE_ENV: 'development' enables OpenAPI viewer + LAN-wide trusted
# origins. Set to 'production' on the Droplet.
NODE_ENV=development

# Port + bind. Dev: any unprivileged port. Prod (behind CF Flexible SSL):
# 80 so the tunnel can reach plain HTTP. Bun needs CAP_NET_BIND_SERVICE
# or root to listen on <1024.
PORT=8100
HOST=127.0.0.1

# ── URLs (every URL the app cares about is env-driven) ───────────────
# FE_URL — comma-separated list of trusted browser origins. CORS
# allowlist + better-auth `trustedOrigins` pull from this.
FE_URL=http://localhost:3130

# BETTER_AUTH_URL — the public canonical URL of THIS backend. Used by
# better-auth to mint redirect URLs (magic links, password reset) and
# to decide Secure-cookie defaults.
BETTER_AUTH_URL=http://localhost:8100
# ── Token lifetimes ────────────────────────────────────────────────
# Both accept the same spellings: `30m`, `8h`, `7d`, or a bare number of
# seconds. Parsed by `src/lib/duration.ts`.
#
# REFRESH_TOKEN_TTL — the better-auth session cookie, i.e. the credential
# /api/auth/refresh exchanges for a new access token. auth.ts derives
# `updateAge = ttl / 2` (min 60s), so an actively-clicking user extends it
# automatically past the half-life and is only kicked after a full idle
# lifetime. (Read from the older name SESSION_EXPIRES_SECONDS if this one
# is absent, so an un-templated deploy keeps working.)
REFRESH_TOKEN_TTL=7d

# ACCESS_TOKEN_TTL — the signed JWT `requireAuth` verifies on every
# request. Shorter = permission changes land sooner without waiting on the
# blacklist; longer = fewer refresh round trips. Local dev runs 8h so a
# working day never interrupts; staging + production override to 30m via
# the GH env variable.
ACCESS_TOKEN_TTL=8h

# SOFFICE_BIN — path to headless LibreOffice. The Reports page's PDF
# format is the report's own XLSX printed by Calc, so the binary has to
# exist wherever the BE runs. Paths differ per platform, which is exactly
# why this is an env var and not a constant:
#
#   macOS (Homebrew cask, Apple silicon)  /opt/homebrew/bin/soffice
#   macOS (Homebrew cask, Intel)          /usr/local/bin/soffice
#   macOS (dragged to Applications)       /Applications/LibreOffice.app/Contents/MacOS/soffice
#   Ubuntu / Debian (libreoffice-calc)    /usr/bin/soffice
#
# Unset → the BE looks for `soffice` on PATH, then (on macOS only) the app
# bundle. XLSX and CSV exports do not need it; only PDF fails, with a
# message naming the path it tried.
SOFFICE_BIN=/opt/homebrew/bin/soffice

# BACKEND_URL — dev-only, shown in the OpenAPI viewer's server picker.
# Optional; defaults to BETTER_AUTH_URL.
# BACKEND_URL=http://localhost:8100

# FE dev port (dev only). Used by `trustedOrigins` to allow LAN access
# from phones/tablets at `http://192.168.x.y:3130` during dev.
FE_PORT=3130

# ── Database ──────────────────────────────────────────────────────────
# DATABASE_URL — primary connection. In prod this points at the
# PgBouncer pool (transaction mode, port 25061). In dev it points at
# the local Postgres container on 5539.
DATABASE_URL=postgresql://postgres:postgres@localhost:5539/thinkcocoa

# DATABASE_DIRECT_URL — optional, only used in prod where the BE needs
# a non-pooled connection for SSE LISTEN + drizzle migrations. Falls
# back to DATABASE_URL when unset (correct for dev).
# DATABASE_DIRECT_URL=postgresql://thinkcocoa_app:<pwd>@<host>:25060/thinkcocoa?sslmode=require

# DATABASE_SSL — set to 'true' for managed DBs (DO, RDS, etc.). Strips
# the `sslmode=...` URL param so node-postgres uses the explicit ssl
# option with `rejectUnauthorized: false`.
DATABASE_SSL=false

# DATABASE_ENCODE_PASSWORD — passphrase for the committed demo snapshot
# `docs/demo-db-dump.sql.gz.enc` (AES-256-CBC, PBKDF2). Used by
# `bun run db:dump` / `bun run db:restore` only; the server never reads
# it. Demo dataset is synthetic, so this is "not plaintext in git",
# not a security boundary.
DATABASE_ENCODE_PASSWORD=replace-with-the-demo-snapshot-passphrase

# Pool sizes — leave defaults unless you need tuning.
# DATABASE_POOL_MAX=10
# DATABASE_DIRECT_POOL_MAX=2

# ── Auth ──────────────────────────────────────────────────────────────
# Min 32 chars. Generate with: openssl rand -base64 48 | tr -d '\n='
BETTER_AUTH_SECRET=replace-with-strong-secret-min-32-chars

# ── External integrations ────────────────────────────────────────────
KOBO_URL=
KOBO_API_KEY=

# ── DigitalOcean Spaces (S3-compatible) ──────────────────────────────
# Same bucket holds both hot uploads (Kobo snapshots written via the
# TieredStorage daily cron) and the cold-tier archives. Create via DO
# Console as Cold Storage — Cold API can't be selected via SDK.
#
# Endpoint is derived from SPACES_REGION (always
# `<region>.digitaloceanspaces.com`). Set `S3_ENDPOINT_OVERRIDE` only
# when testing against a non-DO S3 (e.g. local MinIO).
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=think-cocoa-bucket
SPACES_REGION=fra1

# ── TieredStorage local hot tier ─────────────────────────────────────
# BE always reads from disk; the PM2 cron at 02:05 UTC tar+zstd-ships
# any day-folder older than today to SPACES_BUCKET under the prefix
# `<env>/storage/<YYYY-MM-DD>.tar.zst` (env = SENTRY_ENVIRONMENT or
# NODE_ENV). Hot retention + base prefix are hardcoded constants in
# `apps/be/src/lib/tiered-storage.ts` (HOT_DAYS = 30).
#
# Absolute path outside the deploy dir so `pm2 reload` / deploy
# `tar xzf` over the codebase doesn't wipe the hot folder.
STORAGE_ROOT=/var/lib/think-cocoa/storage

# ── Error tracking ───────────────────────────────────────────────────
# Sentry — leave blank in dev (auto-disables). In staging + prod, the
# deploy workflow stamps the BE project's DSN here from `vars.SENTRY_DSN`.
# Format: https://<key>@o<orgid>.ingest.sentry.io/<projectid>
SENTRY_DSN=
# Release tag — git SHA, set automatically by deploy.yml. Used to map
# bundled stack traces back to source via uploaded source maps.
SENTRY_RELEASE=
#
# NOTE: events are tagged with `NODE_ENV` (injected per-Droplet by
# PM2's `env_<name>` block in ecosystem.config.cjs), so there is NO
# separate SENTRY_ENVIRONMENT var. Staging events show up as
# `staging`, prod events as `production`.

# ── Transactional email (Resend) ─────────────────────────────────────
# Used by better-auth for password reset + magic-link sign-in. If the
# key is absent the app still boots — outgoing emails fall back to
# stdout, so a fresh dev checkout without email creds can still QA
# the auth flow by copy-pasting the printed link. Prod MUST set it.
# Get a key at https://resend.com → API Keys.
RESEND_API_KEY=
# From address. Must be on a verified sender domain in Resend (DKIM/
# SPF/MX pointed at Resend per https://resend.com/domains).
EMAIL_FROM=ThinkData <no-reply@thinkdata.com>
